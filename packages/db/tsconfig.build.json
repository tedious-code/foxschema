{
  // Build config for publishing @foxschema/db to npm. The monorepo consumes
  // src/ directly through the workspace `exports`, so this is only exercised by
  // `npm run build -w @foxschema/db` and by prepare-publish.
  //
  // Unlike packages/sql this package IS the Node runtime — drivers, pools,
  // migration execution — so `@types/node` is expected here, and `nodenext`
  // module resolution keeps the emitted imports loadable by plain Node rather
  // than only by a bundler.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    // Same reasoning as packages/sql: `files` ships dist only, so maps would
    // point at a src/ that is not in the tarball.
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // Resolve @foxschema/sql to its BUILT types, not its source.
    //
    // The workspace symlink makes `exports` point at packages/sql/src/index.ts,
    // so without this tsc followed it, compiled sql's TypeScript as part of this
    // build, and emitted ~334 .js/.d.ts files *next to sql's sources* — stale
    // output shadowing the real files. `paths` is relative to this file; no
    // `baseUrl`, which TS 7 removes.
    //
    // This makes sql's dist a hard prerequisite, which is exactly the edge
    // turbo.json declares as `build: dependsOn ["^build"]`.
    "paths": {
      "@foxschema/sql": ["../sql/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.it.test.ts"]
}
