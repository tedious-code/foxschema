{
  // Build config for publishing to npm. The monorepo consumes src/ directly
  // (via bundler aliases), so this is only exercised by `npm run build` here.
  //
  // moduleResolution "nodenext" is the point: it rejects extensionless relative
  // imports, which is exactly what made the package unimportable from plain
  // Node. Keeping it strict here means the build fails loudly rather than
  // shipping something only a bundler can read.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "declaration": true,
    // No maps. `files` in the published manifest is ["dist", …] — src/ is not
    // in the tarball, so every .js.map / .d.ts.map would point at a
    // `../src/*.ts` that does not exist on the consumer's disk: ~110 dead files
    // that break Go-to-Definition instead of enabling it. Ship src/ first if
    // these are ever wanted back.
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    // No DOM, no @types/node: this package must not reach for either. If a
    // Node built-in or a browser global sneaks in, the build breaks here.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
