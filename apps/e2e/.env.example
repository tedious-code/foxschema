# Copy to apps/e2e/.env (gitignored). Matches docker-compose.yml Postgres.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_POSTGRES_SOURCE_HOST=127.0.0.1
E2E_POSTGRES_SOURCE_PORT=5432
E2E_POSTGRES_SOURCE_DB=foxdb
E2E_POSTGRES_SOURCE_USER=foxuser
E2E_POSTGRES_SOURCE_PASS=foxpass
E2E_POSTGRES_SOURCE_SCHEMA=demo_a
E2E_POSTGRES_TARGET_HOST=127.0.0.1
E2E_POSTGRES_TARGET_PORT=5432
E2E_POSTGRES_TARGET_DB=foxdb
E2E_POSTGRES_TARGET_USER=foxuser
E2E_POSTGRES_TARGET_PASS=foxpass
E2E_POSTGRES_TARGET_SCHEMA=demo_b
